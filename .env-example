# Sherlock G1 API scorer configuration — copy to `.env` and edit. `.env` is git-ignored; never commit it.
# Any provider below lets a reviewer re-run every experiment with their own key. The paper runs used
# `vertex` with Application Default Credentials (see "Run it with your own API key" in the README).

# --- provider and model ---------------------------------------------------------------------
# vertex       : Google Vertex AI, Application Default Credentials (gcloud auth application-default login)
# gemini_api   : Google Generative Language API with an API key
# openai_compat: any /chat/completions endpoint (OpenAI, ollama, Groq, Together, ...)
SHERLOCK_G1_PROVIDER=vertex
SHERLOCK_G1_MODEL=gemini-2.5-flash

# --- vertex (ADC; no key) --------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# 0 disables "thinking" on Gemini 2.5 models (the paper runs scored with 0: deterministic, no thought
# tokens). Leave the value empty to omit thinkingConfig for models that do not support it.

# --- openai_compat / gemini_api ---------------------------------------------------------------
# SHERLOCK_G1_BASE_URL=http://127.0.0.1:11434/v1   # e.g. a local ollama server (`ollama serve`)
# SHERLOCK_G1_API_KEY=sk-...

# --- call behaviour (identical across experiments; the card is the only thing that varies) ------
SHERLOCK_G1_TEMPERATURE=0
SHERLOCK_G1_MAX_OUTPUT_TOKENS=256
SHERLOCK_G1_THINKING_BUDGET=0
SHERLOCK_G1_TIMEOUT_S=120
# passes per card: >= 5 for the hosted G1 comparisons (metrics spec §6.7); passes measure across-call
# agreement of the produced order, not vote share
SHERLOCK_G1_PASSES=5
# concurrent calls (the runner is IO-bound; 16 is polite to both Vertex and ollama)
SHERLOCK_G1_CONCURRENCY=16

# --- the truncation flag (the mechanism under test) ---------------------------------------------
# your model's INPUT context window in tokens: a card whose prompt exceeds it is truncated and gets no
# score, exactly like a cut laya card. Leave unset only if you accept no truncation flags.
# vertex/gemini_api Gemini 2.5 Flash: 1000000; ollama gemma4:e2b: the server's context length (e.g. 8192)
SHERLOCK_G1_MAX_INPUT_TOKENS=1000000

# --- cost table (metrics spec §4: implied USD at the published price) ---------------------------
# USD per 1M tokens; SHERLOCK_G1_PRICE_SOURCE is quoted verbatim in the artifact (provider + date)
SHERLOCK_G1_PRICE_IN=0.30
SHERLOCK_G1_PRICE_OUT=2.50
SHERLOCK_G1_PRICE_SOURCE=Google Cloud Vertex AI published price for gemini-2.5-flash, 2026-11-14
